# 复制为 .env 使用。首次启动以本文件(或代码默认值)作种子写入 system_settings,
# 之后修改 .env 不再生效, 日志除外(界面可热更)。

# ---- 数据库(必填, 仅支持 PostgreSQL) ----
DATABASE__URL=postgresql+asyncpg://cronix:cronix@127.0.0.1:5432/cronix
DATABASE__SSL=false

# ---- JWT(必填, secret ≥ 32 字符) ----
JWT__SECRET=change-me-to-a-random-32-char-secret-value
JWT__ACCESS_EXPIRE_MINUTES=30
JWT__REFRESH_EXPIRE_DAYS=30

# ---- 运行时(system/base 首启种子, 之后在界面修改、重启生效) ----
RUNTIME__DEFAULT_TIMEOUT=120
RUNTIME__MAX_CONCURRENT_RUNS=4
RUNTIME__SHUTDOWN_TIMEOUT=30
RUNTIME__MISFIRE_GRACE_SECONDS=60
RUNTIME__NOTIFY_TIMEOUT=30

# ---- 日志(首启种子, 之后可在界面热更新) ----
# 控制台与文件(data/logs)固定开启, 每日 00:00 滚动, 不压缩
LOGGING__LEVEL=INFO
LOGGING__RETENTION=7 days

# ---- CORS(开发期 Vite 5173, JSON 数组) ----
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
